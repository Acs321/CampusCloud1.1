# Copiar como docker/.env y configurar contraseñas UNICAMENTE en el equipo local.
# No subir docker/.env a Classroom ni GitHub.
MONGO_INITDB_ROOT_USERNAME=salvador
MONGO_INITDB_ROOT_PASSWORD=REEMPLAZAR_LOCALMENTE
NEO4J_PASSWORD=REEMPLAZAR_LOCALMENTE
MSSQL_SA_PASSWORD=REEMPLAZAR_LOCALMENTE
POSTGRES_USER=salvador
POSTGRES_PASSWORD=REEMPLAZAR_LOCALMENTE
POSTGRES_DB=campuscloud
PGADMIN_DEFAULT_EMAIL=salvador@example.invalid
PGADMIN_DEFAULT_PASSWORD=REEMPLAZAR_LOCALMENTE
MONGO_PORT=27017
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
CASSANDRA_PORT=9042
MSSQL_PORT=1433
POSTGRES_PORT=5432
PGADMIN_PORT=5050
